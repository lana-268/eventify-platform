generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(ATTENDEE)
  createdAt     DateTime       @default(now())
  bookings      Booking[]
  events        Event[]        @relation("OrganizerEvents")
  refreshTokens RefreshToken[]
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String
  venue       String?
  startsAt    DateTime
  capacity    Int
  priceCents  Int
  organizerId String
  createdAt   DateTime  @default(now())
  organizer   User      @relation("OrganizerEvents", fields: [organizerId], references: [id])
  bookings    Booking[]
}

model Booking {
  id        String        @id @default(uuid())
  userId    String
  eventId   String
  status    BookingStatus @default(CONFIRMED)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  event     Event         @relation(fields: [eventId], references: [id])

  @@unique([userId, eventId])
  @@index([userId, createdAt(sort: Desc)])
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  tokenHash    String    @unique
  userId       String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique @db.Uuid
  createdAt    DateTime  @default(now())

  user       User          @relation(fields: [userId], references: [id])
  replacedBy RefreshToken? @relation("RotationChain", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("RotationChain")

  @@index([userId])
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  WAITLISTED
}
